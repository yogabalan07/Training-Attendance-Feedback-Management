# Neon PostgreSQL connection string (with SSL).
# Get from: Neon dashboard → Connection Details → Pooled connection string.
# For migrations locally use the *direct* connection string.
DATABASE_URL="postgresql://user:password@ep-<id>.pooler.<region>.neon.tech/smart_training?sslmode=require"
JWT_SECRET="generate-a-long-random-string-here"
JWT_EXPIRES_IN="24h"
BACKEND_PORT=3001
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
NODE_ENV=development