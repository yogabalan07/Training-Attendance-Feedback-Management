# ─────────────────────────────────────────────────────────────
# Environment variables — copy to .env and fill in real values.
# NEVER commit .env. NEVER expose DATABASE_URL to the frontend.
# ─────────────────────────────────────────────────────────────

# Backend
# Neon PostgreSQL connection string (with SSL).
# Get this from your Neon project dashboard → Connection Details.
# Use the *pooled* connection string for serverless production traffic:
#   postgresql://user:password@ep-<id>.pooler.region.aws.neon.tech/<dbname>?sslmode=require
# Or the direct connection string for migrations/local tools:
#   postgresql://user:password@ep-<id>.region.aws.neon.tech/<dbname>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/smart_training?sslmode=require"

# JWT authentication
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_IN="24h"

# Server
BACKEND_PORT=3001

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Frontend (.env at repo root also accepted)
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api